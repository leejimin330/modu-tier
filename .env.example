# Supabase (비워두면 로컬 개발 모드: 개발용 로그인 + .data/dev-db.json)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것
SUPABASE_SECRET_KEY=

# 관리자 사용자 id (Supabase auth.users의 uuid, 쉼표로 여러 명)
ADMIN_USER_IDS=

# 운영 빌드에서 Supabase 없이 개발용 로그인을 허용하려면 1 (테스트 배포용)
# ALLOW_DEV_LOGIN=1

# 구글 애드센스 (비워두면 광고 없음)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_TOPIC=

# 사이트 주소 (공유 링크 미리보기 이미지의 절대 주소에 쓰임)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 카카오톡 공유 버튼 (카카오 개발자 콘솔의 JavaScript 키, 사이트 도메인 등록 필요). 비워두면 버튼 숨김
NEXT_PUBLIC_KAKAO_JS_KEY=
